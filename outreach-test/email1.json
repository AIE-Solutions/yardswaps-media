[{"from": "YardSwaps <hello@mail.yardswaps.com>", "to": ["__TO__"], "reply_to": "support@yardswaps.com", "subject": "Quick one about your yard", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"x-apple-disable-message-reformatting\">\n  <meta name=\"color-scheme\" content=\"light dark\">\n  <meta name=\"supported-color-schemes\" content=\"light dark\">\n  <title></title>\n  <style>\n    /* Limited set of selectors that survive most clients. */\n    @media (max-width: 600px) {\n      .email-container { width: 100% !important; }\n      .email-padding { padding-left: 20px !important; padding-right: 20px !important; }\n      .email-btn { display: block !important; width: 100% !important; }\n    }\n    a { color: #2563EB; }\n  </style>\n</head>\n<body style=\"margin: 0; padding: 0; background-color: #F6F6F8; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;\">\n  <!-- Preheader: controls Gmail/Apple Mail inbox preview. Hidden from rendered view. -->\n  <div style=\"display: none; max-height: 0; overflow: hidden; mso-hide: all; font-size: 1px; line-height: 1px; color: #F6F6F8;\">\n    Free to list, no selling fee, local pickup in Houston.\n  </div>\n\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color: #F6F6F8;\">\n    <tr>\n      <td align=\"center\" style=\"padding: 32px 16px;\">\n        <table role=\"presentation\" class=\"email-container\" width=\"560\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width: 560px; width: 100%; background-color: #FFFFFF; border-radius: 16px; overflow: hidden; box-shadow: 0 1px 3px rgba(26,51,83,0.06);\">\n          <!-- Header -->\n          <tr>\n            <td class=\"email-padding\" style=\"padding: 24px 32px; border-bottom: 1px solid #E9E9EB;\">\n              <a href=\"https://www.yardswaps.com\" style=\"text-decoration: none; font-family: 'Space Grotesk', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 22px; font-weight: 700; color: #1A3353; letter-spacing: -0.01em;\">\n                <!-- Empty alt \u2014 the wordmark next to the icon already says\n                     \"YardSwaps\", so when the image fails to load (Gmail's\n                     image proxy, no-images-by-default settings, slow CDN)\n                     the alt text doesn't double up the brand name. -->\n                <img src=\"https://www.yardswaps.com/email-logo.png\" width=\"32\" height=\"32\" alt=\"\" style=\"vertical-align: middle; margin-right: 10px; border: 0;\"><span style=\"vertical-align: middle;\">Yard<span style=\"color: #2563EB;\">Swaps</span></span>\n              </a>\n            </td>\n          </tr>\n\n          <!-- Body -->\n          \n          <tr>\n            <td class=\"email-padding\" style=\"padding: 28px 32px 32px 32px; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.6; color: #545456;\">\n              \n    <p style=\"margin: 0 0 14px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.6; color: #545456;\">Hi Alan,</p>\n    <p style=\"margin: 0 0 14px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.6; color: #545456;\">I'm Alan, co-founder of YardSwaps, a marketplace for used commercial equipment that's starting here in Houston. YardSwaps Test looked like a good fit.</p>\n    <p style=\"margin: 0 0 14px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.6; color: #545456;\">Listing is free with no selling fee, and buyers pick up and pay you directly. Snap a few photos and the AI writes the listing. List 4 items in your first 14 days and all of them get boosted free for 14 days.</p>\n    \n  <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin: 8px 0;\">\n    <tr>\n      <td align=\"left\">\n        <!--[if mso]>\n        <v:roundrect xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:w=\"urn:schemas-microsoft-com:office:word\" href=\"https://www.yardswaps.com/signup?utm_source=coldemail&amp;utm_medium=seq1&amp;utm_campaign=seed_2026_q2&amp;utm_content=dealer&amp;utm_term=1bc5b2d\" style=\"height:44px;v-text-anchor:middle;width:200px;\" arcsize=\"27%\" strokecolor=\"#2563EB\" fillcolor=\"#2563EB\">\n          <w:anchorlock/>\n          <center style=\"color:#FFFFFF;font-family:sans-serif;font-size:15px;font-weight:600;\">Post your first item, free</center>\n        </v:roundrect>\n        <![endif]-->\n        <!--[if !mso]><!-- -->\n        <a href=\"https://www.yardswaps.com/signup?utm_source=coldemail&amp;utm_medium=seq1&amp;utm_campaign=seed_2026_q2&amp;utm_content=dealer&amp;utm_term=1bc5b2d\" class=\"email-btn\" style=\"display: inline-block; padding: 12px 24px; background-color: #2563EB; color: #FFFFFF; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 15px; font-weight: 600; text-decoration: none; border-radius: 12px; border: 1.5px solid #2563EB; mso-hide: all;\">\n          Post your first item, free\n        </a>\n        <!--<![endif]-->\n      </td>\n    </tr>\n  </table>\n    <p style=\"margin: 0 0 14px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.6; color: #545456;\">Want more? An optional storefront adds your own shop page, no listing cap, bulk upload and an inventory feed. It's free for 90 days, then $49/mo: <a href=\"https://www.yardswaps.com/dealers\">yardswaps.com/dealers</a></p>\n    <p style=\"margin: 0 0 14px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.6; color: #545456;\"><a href=\"https://www.yardswaps.com/flyers/yardswaps-sales-flyer.pdf\" style=\"text-decoration: none;\"><img src=\"https://www.yardswaps.com/flyers/yardswaps-sales-flyer-thumb.jpg\" width=\"200\" alt=\"YardSwaps one-page flyer: equipment sitting idle? List it free.\" style=\"display: block; width: 200px; max-width: 100%; height: auto; border: 1px solid #D8D8DA; border-radius: 8px;\"></a><span style=\"display: block; margin-top: 6px;\"><a href=\"https://www.yardswaps.com/flyers/yardswaps-sales-flyer.pdf\">One-page flyer (PDF)</a></span></p>\n    <p style=\"margin: 0 0 14px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.6; color: #545456;\">Thanks,<br>Alan</p><p style=\"margin: 0 0 14px 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.6; color: #545456;\"><span style=\"color: #686869;\">Co-founder, YardSwaps \u00b7 yardswaps.com</span></p>\n  \n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td class=\"email-padding\" style=\"padding: 20px 32px; border-top: 1px solid #E9E9EB; background-color: #FFFFFF;\">\n              <div style=\"font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 12px; color: #656567; line-height: 1.6;\">\n                &copy; 2026 YardSwaps \u00b7 4717 Hondo Pass Dr PMB 3165, El Paso, TX 79904-1456 \u00b7 <a href=\"https://www.yardswaps.com/unsubscribe?t=sample\" style=\"color: #2563EB; text-decoration: underline;\">Unsubscribe</a>\n              </div>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>", "headers": {"List-Unsubscribe": "<https://www.yardswaps.com/unsubscribe?t=sample>, <mailto:unsubscribe@mail.yardswaps.com?subject=unsubscribe>", "List-Unsubscribe-Post": "List-Unsubscribe=One-Click"}, "tags": [{"name": "category", "value": "inbox_test"}]}]